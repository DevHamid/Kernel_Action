CONFIG_ENV=config.env

KERNEL_SOURCE=https://github.com/DevHamid/LKGeek_sdm660
KERNEL_CONFIG=vendor/wayne-oss-perf_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb
KERNEL_IMAGE_NAME_MKBOOTIMG=Image.gz-dtb
ARCH=arm64
ADD_LOCALVERSION_TO_FILENAME=false
EXTRA_CMDS:LD=ld.lld

#LLVM
USE_LLVM=false
LLVM_LINK=https://github.com/llvm/llvm-project/releases/download/llvmorg-21.1.0/LLVM-21.1.0-Linux-X64.tar.xz
LLVM_USE_TARGZ=false
LLVM_Files=LLVM-21.1.0-Linux-X64.tar.xz
LLVM_DIRECTORY=kernel_workspace/LLVM/LLVM-21.1.0-Linux-X64

# Clang
USE_CLANG=true

## Custom — ZyCromerZ Clang 16.0.6 (safe for 4.19)
USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/ZyCromerZ/Clang/releases/download/16.0.6-20260807-release/Clang-16.0.6-20260807.tar.gz
CUSTOM_CLANG_BRANCH=16.0.6-20260807

### link via clang-aosp/bin; lld 16 from same release set as LD
CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

### AOSP (unused: USE_CUSTOM_CLANG=true)
#CLANG_BRANCH=master
#CLANG_VERSION=r547379
# GCC
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true
USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-
USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# KernelSU flags
ENABLE_KERNELSU=false
KERNELSU_TAG=main
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# Configuration
DISABLE-LTO=false
DISABLE_CC_WERROR=false
ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=false

# Ccache
ENABLE_CCACHE=true

# DTBO image
NEED_DTBO=false

# Build boot images
BUILD_BOOT_IMG=true
SOURCE_BOOT_IMAGE=https://github.com/DevHamid/Kernel_Action/raw/refs/heads/test-images/S-clean-ourDTB.img

# rev b9bbc3c5b: hung-task/softlockup debug + panic-timeout 10, pstore capture
# rev bdcd8e785: DEBUG_FS=y fixes vidc_3x tracepoint link errors
# rev 1dbf6d866: compile mq-deadline so fallback engages (was none)

# B7 — Vanilla baseline, zero custom patches
# CONFIG_KSU_SUSFS_SUS_MOUNT=n (B7 vanilla: KSU off; do NOT leak into make)
# CONFIG_KSU=n
# CONFIG_KSU_SUSFS=n
