# Known-good shape for scripts/Dockerfile (Memos fork).
# Prereq: .dockerignore must NOT exclude /web/ (upstream excludes it).

# =============================================================================
# Build stage: frontend assets
# =============================================================================
FROM node:24-alpine AS frontend-builder

WORKDIR /app/web

# corepack prepare is unreliable here; install pnpm via npm directly
RUN npm install -g pnpm@11.0.1

# Package files first for layer caching
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# 'release' outputs to ../server/frontend/dist (what go:embed expects);
# 'build' would output to web/dist
COPY web/ ./
RUN pnpm release

# =============================================================================
# Build stage: Go backend
# =============================================================================
FROM golang:1.27-alpine AS go-builder

WORKDIR /app

RUN apk add --no-cache git make gcc musl-dev

COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=frontend-builder /app/server/frontend/dist ./server/frontend/dist

ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_DATE=unknown

RUN echo "Building with VERSION=${VERSION} COMMIT=${COMMIT} BUILD_DATE=${BUILD_DATE}" && \
    CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH \
    go build \
        -trimpath \
        -ldflags="-s -w -X github.com/usememos/memos/internal/version.Version=${VERSION} -X github.com/usememos/memos/internal/version.Commit=${COMMIT} -extldflags '-static'" \
        -tags netgo,osusergo \
        -o memos \
        ./cmd/memos

# =============================================================================
# Runtime stage
# =============================================================================
FROM alpine:3.20

RUN apk add --no-cache ca-certificates tzdata su-exec sqlite

RUN addgroup -g 10001 -S memos && \
    adduser -u 10001 -S -G memos -h /var/opt/memos -s /sbin/nologin memos

COPY --from=go-builder /app/memos /usr/local/bin/memos
COPY scripts/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

VOLUME ["/var/opt/memos"]
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["memos", "--data", "/var/opt/memos", "--port", "5230"]
